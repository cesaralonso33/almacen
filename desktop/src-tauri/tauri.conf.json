{
  "productName": "Custodia CradSystem",
  "version": "0.1.19",
  "identifier": "mx.institucion.custodia",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Custodia CradSystem", "width": 1280, "height": 820 }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; frame-src blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Institución",
    "copyright": "Uso institucional",
    "category": "Business",
    "shortDescription": "Almacén y custodia de expedientes jurídicos",
    "longDescription": "Solicitud, entrega, devolución y cadena de custodia de expedientes jurídicos físicos con operación offline.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEwQzk3MzM1RUNDQkM4MUYKUldRZnlNdnNOWFBKb05kaFdYUVVjcDE0RnJCZVlTVU8xZE9JY2R3NDR2QnN1QkdOL3hEWG0vMC8K",
      "endpoints": ["https://129-121-117-177.sslip.io/updates/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
