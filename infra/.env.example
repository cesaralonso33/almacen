# Copiar a infra/.env y completar. Nunca versionar este archivo.
POSTGRES_DB=expedientes
POSTGRES_USER=expedientes
POSTGRES_PASSWORD=cambie_esta_clave_de_desarrollo
JWT_SECRET=cambie_por_un_secreto_aleatorio_de_al_menos_32_caracteres

# Nombre DNS interno por el que los clientes alcanzan la API.
# Sin dominio, puede usar la IP del VPS junto con Caddyfile.interno (CA interna).
SITIO=almacen.institucion.mx

# Certificados institucionales montados en /certs (ver infra/certs/LEEME.md).
TLS_CERT=/certs/tls.crt
TLS_KEY=/certs/tls.key

# Variante del proxy:
#   ./Caddyfile             certificados institucionales
#   ./Caddyfile.publico     dominio público con Let's Encrypt
#   ./Caddyfile.interno     solo IP o LAN con CA interna de Caddy
#   ./Caddyfile.http        SIN cifrado, solo red cerrada (VPN/firewall)
# Para VPS público, cambie CADDYFILE a ./Caddyfile.publico y SITIO a un
# dominio que resuelva a la IP pública. El script preparar-vps.sh lo configura.
# Si cambia esta variable, recree Caddy para aplicar el montaje:
#   docker compose up -d --force-recreate caddy
# En Portainer: Stacks -> expedientes -> Update the stack.
CADDYFILE=./Caddyfile

# Directorio de certificados institucionales para el modo CLI.
# En Portainer se usa una ruta absoluta generada por preparar-vps.sh --portainer.
# CERTS_DIR=./certs

# Interfaz donde Caddy publica 80/443. 0.0.0.0 = todas; para LAN/VPN use la IP
# del servidor en esa red. Docker publica los puertos sin pasar por UFW.
# BIND_IP=0.0.0.0

# Directorio de instaladores y latest.json servido en /updates.
# En Portainer debe ser una ruta absoluta del host.
# UPDATES_DIR=./updates

# Imagen ya construida para el stack de Portainer (docker-compose.portainer.yml).
# API_IMAGE=expedientes-api:local

# VPS con dominio público: correo opcional para avisos de Let's Encrypt.
# No se pasa automáticamente al contenedor: si lo usa, agréguelo al bloque global
# del Caddyfile.publico.
# ACME_EMAIL=operacion@institucion.mx

# Operación
RETENCION_DIAS=30
ACCESS_TTL_MINUTOS=1080
REFRESH_TTL_MINUTOS=1440
IDLE_TTL_MINUTOS=1080
RESERVA_TTL_MINUTOS=30
RUST_LOG=info
