# Copiar a infra/.env y completar. Nunca versionar este archivo.
POSTGRES_DB=expedientes
POSTGRES_USER=expedientes
POSTGRES_PASSWORD=cambie_esta_clave_de_desarrollo
JWT_SECRET=cambie_por_un_secreto_aleatorio_de_al_menos_32_caracteres

# Nombre DNS interno por el que los clientes alcanzan la API.
# Sin dominio, puede usar la IP del VPS junto con Caddyfile.interno (CA interna).
SITIO=almacen.institucion.mx

# Certificados institucionales montados en /certs (ver infra/certs/LEEME.md).
TLS_CERT=/certs/tls.crt
TLS_KEY=/certs/tls.key

# Variante del proxy:
#   ./Caddyfile             certificados institucionales
#   ./Caddyfile.publico     dominio público con Let's Encrypt
#   ./Caddyfile.interno     solo IP o LAN con CA interna de Caddy
#   ./Caddyfile.http        SIN cifrado, solo red cerrada (VPN/firewall)
CADDYFILE=./Caddyfile

# VPS con dominio público: correo para Let's Encrypt (Caddyfile.publico).
ACME_EMAIL=operacion@institucion.mx

# Operación
RETENCION_DIAS=30
ACCESS_TTL_MINUTOS=15
REFRESH_TTL_MINUTOS=10080
RESERVA_TTL_MINUTOS=30
RUST_LOG=info
