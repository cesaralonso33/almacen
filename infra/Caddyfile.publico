# VPS con dominio público: Caddy obtiene y renueva el certificado automáticamente.
#
# Requisitos:
#   - Registro DNS A (y AAAA si aplica) de {$SITIO} apuntando a la IP del VPS.
#   - Puertos 80 y 443 accesibles desde internet.
#   - Sin proxy delante durante la emisión (Cloudflare en modo DNS only).
#
# Correo opcional para avisos de Let's Encrypt: si lo desea, agregue al inicio de este
# archivo el bloque:
#
#   {
#       email operacion@institucion.mx
#   }
#
# Uso: CADDYFILE=./Caddyfile.publico en infra/.env

{$SITIO} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        -Server
    }

    reverse_proxy api:3000 {
        health_uri /health
        health_interval 30s
    }

    log {
        output file /data/access.log {
            roll_size 10MiB
            roll_keep 10
        }
        format console
    }
}
